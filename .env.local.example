# Supabase (copy to .env.local)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only — never expose to the browser / never commit
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key

# Used for OAuth + email redirect callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Leonardo.ai — primary pixel-pet generator (same CHIBI prompts as RD copy)
# https://app.leonardo.ai → API Access
# ---------------------------------------------------------------------------
LEONARDO_API_KEY=
# nano-banana / auto = Gemini Flash Image (web UI "Nano Banana")
LEONARDO_MODEL_ID=nano-banana
LEONARDO_IMAGE_REF_STRENGTH=HIGH
PIXEL_ENGINE=leonardo
# PIXEL_AI_FALLBACK=local

# Optional: Retro Diffusion (prompts live in retro-diffusion.ts; unused when leonardo)
# RETRO_DIFFUSION_API_KEY=
# PIXEL_AI_QUALITY=pro

# Required in mainland China when VPN/Clash is on — Node does NOT use system proxy by default.
# Bitz Net example (port from VPN → Settings → SOCKS5/HTTP 端口):
# PIXEL_HTTPS_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# After generate, the site creates PET-XXXX sync codes (see supabase/migration_sync_codes.sql)
# Extension new-tab redeems them via GET /api/sync-codes/:code

# Chrome Web Store listing (used by homepage Free → install modal). Placeholder until published.
# NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/pixel-alley/YOUR_ID

# ---------------------------------------------------------------------------
# Lemon Squeezy (checkout overlay + license validation)
# ---------------------------------------------------------------------------
# Public checkout links (Overlay). Replace with your real product checkout URLs.
NEXT_PUBLIC_LEMON_CHECKOUT_PREMIUM=https://your-store.lemonsqueezy.com/checkout/buy/premium-id
NEXT_PUBLIC_LEMON_CHECKOUT_CREDITS=https://your-store.lemonsqueezy.com/checkout/buy/credits-id
# Server-only API key for License Key validation (never expose to the browser)
# LEMON_SQUEEZY_API_KEY=
